#!/usr/bin/env bash
# codex-app-send - start a new thread in the Codex desktop app and submit a prompt.
#
# Opens codex://threads/new?path=...&prompt=..., presses Return in the app,
# confirms submission by finding the new session rollout file, and optionally
# waits for the turn to finish and prints only Codex's final message.
#
# https://github.com/Shuo-O/claude-codex-bridge
set -euo pipefail

VERSION="0.1.0"
SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")")" && pwd)"

BUNDLE_ID="${CODEX_APP_BUNDLE_ID:-com.openai.codex}"
SESSIONS_DIR="${CODEX_SESSIONS_DIR:-${CODEX_HOME:-$HOME/.codex}/sessions}"
DELAY="${CODEX_SEND_DELAY:-2.5}"
CONFIRM_TIMEOUT="${CODEX_SEND_CONFIRM_TIMEOUT:-30}"
WAIT=""
NO_SEND=0
QUIET=0

usage() {
  cat <<'EOF'
Usage: codex-app-send [options] <workspace> <prompt | @file | ->

Start a new thread in the Codex desktop app (macOS) and submit a prompt.

Arguments:
  workspace           Absolute path of the project directory for the thread
  prompt              Prompt text, @path to read it from a file, or - for stdin

Options:
  -w, --wait SECONDS  After sending, wait up to SECONDS for the turn to finish
                      and print Codex's final message (exit 2 on timeout)
  -d, --delay SECONDS Wait before pressing Return (default 2.5, env CODEX_SEND_DELAY)
  -n, --no-send       Only open the thread with the prompt prefilled; do not press Return
  -q, --quiet         Print only the session file path (and final message with -w)
  -h, --help          Show this help
  -V, --version       Show version

Output (default):
  SENT <tag>
  SESSION <rollout .jsonl path>
  ----- FINAL -----            (with --wait)
  <final message>

Environment:
  CODEX_APP_BUNDLE_ID           App bundle id (default com.openai.codex)
  CODEX_HOME / CODEX_SESSIONS_DIR  Where session rollouts live (default ~/.codex/sessions)
  CODEX_SEND_CONFIRM_TIMEOUT    Seconds to wait for submission to show up (default 30)

Exit codes: 0 ok, 1 error / not submitted, 2 wait timed out (thread keeps running)
EOF
}

die() { echo "codex-app-send: $*" >&2; exit 1; }
log() { [[ "$QUIET" == 1 ]] || echo "$@"; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    -w|--wait) WAIT="${2:?--wait needs SECONDS}"; shift 2 ;;
    -d|--delay) DELAY="${2:?--delay needs SECONDS}"; shift 2 ;;
    -n|--no-send) NO_SEND=1; shift ;;
    -q|--quiet) QUIET=1; shift ;;
    -h|--help) usage; exit 0 ;;
    -V|--version) echo "codex-app-send $VERSION"; exit 0 ;;
    --) shift; break ;;
    -?*) die "unknown option: $1 (see --help)" ;;
    *) break ;;
  esac
done

[[ $# -eq 2 ]] || { usage >&2; exit 1; }
WORKSPACE="$1"; PROMPT="$2"

[[ "$(uname -s)" == "Darwin" ]] || die "macOS only (uses the codex:// URL scheme and System Events)"
[[ "$WORKSPACE" == /* ]] || die "workspace must be an absolute path: $WORKSPACE"
[[ -d "$WORKSPACE" ]] || die "workspace does not exist: $WORKSPACE"

if [[ "$PROMPT" == "-" ]]; then
  PROMPT="$(cat)"
elif [[ "$PROMPT" == @* ]]; then
  f="${PROMPT#@}"; [[ -f "$f" ]] || die "prompt file not found: $f"
  PROMPT="$(cat "$f")"
fi
[[ -n "${PROMPT//[[:space:]]/}" ]] || die "prompt is empty"

# A unique tag lets us find exactly this thread's rollout file afterwards.
TAG="ccb-$(date +%s)-$$-$RANDOM"
PROMPT="$PROMPT

[$TAG]"

MARK="$(mktemp -t codex-app-send)"
trap 'rm -f "$MARK"' EXIT

URL="$(python3 -I -c '
import sys, urllib.parse as u
print("codex://threads/new?" + u.urlencode({"path": sys.argv[1], "prompt": sys.argv[2]}, quote_via=u.quote))
' "$WORKSPACE" "$PROMPT")"

open "$URL" || die "failed to open codex:// URL (is the Codex app installed?)"

if [[ "$NO_SEND" == 1 ]]; then
  log "PREFILLED $TAG"
  exit 0
fi

sleep "$DELAY"

# Press Return only if the Codex app is frontmost, so a stray keystroke never
# lands in another application.
press_return() {
  osascript - "$BUNDLE_ID" <<'EOF'
on run argv
  set bundleId to item 1 of argv
  tell application id bundleId to activate
  delay 0.3
  tell application "System Events"
    set frontId to bundle identifier of first application process whose frontmost is true
    if frontId is not bundleId then error "Codex app is not frontmost (front: " & frontId & ")"
    key code 36
  end tell
end run
EOF
}

if ! err="$(press_return 2>&1)"; then
  if [[ "$err" == *"1002"* || "$err" == *"not allowed"* || "$err" == *"不允许"* ]]; then
    die "macOS blocked the keystroke. Grant Accessibility access to the app running this script
(System Settings > Privacy & Security > Accessibility), then retry. Details: $err"
  fi
  die "could not press Return: $err"
fi

find_session() {
  find "$SESSIONS_DIR" -name '*.jsonl' -newer "$MARK" -exec /usr/bin/grep -l -F "$TAG" {} + 2>/dev/null | head -1 || true
}

FILE=""
retried=0
for ((i = 0; i < CONFIRM_TIMEOUT; i++)); do
  FILE="$(find_session)"
  [[ -n "$FILE" ]] && break
  # The composer may not have been focused yet; press Return once more.
  # An extra Return on an empty composer is a no-op.
  if [[ "$i" -eq 8 && "$retried" -eq 0 ]]; then
    press_return >/dev/null 2>&1 || true
    retried=1
  fi
  sleep 1
done

[[ -n "$FILE" ]] || die "no submission detected within ${CONFIRM_TIMEOUT}s. The prompt may still be
prefilled in the app; press Return there, or retry with a longer --delay."

if [[ "$QUIET" == 1 ]]; then echo "$FILE"; else echo "SENT $TAG"; echo "SESSION $FILE"; fi

[[ -z "$WAIT" ]] && exit 0

[[ "$QUIET" == 1 ]] || echo "----- FINAL -----"
exec "$SCRIPT_DIR/codex-app-result" --wait "$WAIT" "$FILE"
